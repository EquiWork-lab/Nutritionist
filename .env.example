# ==========================================================================
#  .env.example  —  copy to .env.local and fill in.  NEVER commit real keys.
#
#  This file is the SINGLE source of everything account-specific.  Migrating
#  the whole project to a new owner = create fresh accounts, paste new values
#  here, redeploy.  Zero code changes.  See MIGRATION.md.
# ==========================================================================

# --- Public site ----------------------------------------------------------
# Full public URL of the deployment (used for payment return URLs, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Anna Ivanova Nutrition

# --- Supabase (Auth + Postgres + Storage) ---------------------------------
# Project → Settings → API.  Create a NEW Supabase project per owner.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only.  Never exposed to the browser.  Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Payments -------------------------------------------------------------
# Which provider is active.  Options: "bepaid" | "webpay" | "mock"
# Use "mock" during early development (no real gateway account needed).
PAYMENT_PROVIDER=mock

# Sandbox vs live.  Keep "test" until a real merchant account + legal status
# (ИП / расчётный счёт) exist.  See MIGRATION.md and the legal note in README.
PAYMENT_MODE=test

# bePaid (recommended for recurring subscriptions).  https://docs.bepaid.by
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
# Secret used to verify incoming webhook notifications.
BEPAID_WEBHOOK_SECRET=

# WEBPAY (alternative).  https://docs.webpay.by
WEBPAY_STORE_ID=
WEBPAY_SECRET_KEY=
WEBPAY_WEBHOOK_SECRET=
